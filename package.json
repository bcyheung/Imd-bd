{
  "name": "ims-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply ims --local",
    "db:migrate:remote": "wrangler d1 migrations apply ims --remote",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "check:requirements": "node scripts/requirements-check.mjs"
  },
  "dependencies": {
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.37.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260921.1": true
  }
}
